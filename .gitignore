# Ignorowanie plików środowiskowych (szablony *.env.example zostają w repo)
.env
.env/*
env/*
!env/*.env.example
.env/

# Ignorowanie wirtualnego środowiska
.venv/

__pycache__/
*.pyc

# Artefakty buildów i narzędzi
*.egg-info/
.ruff_cache/
.pytest_cache/

# Hasło vault (tylko lokalnie / na runnerze)
.vault_pass
